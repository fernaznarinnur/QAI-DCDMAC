# Experiments
# ----------------------------------------------------------------------------------------
METRICS = ["throughput", "pdr", "delay_ms", "reliability", "lifetime", "overhead"]
TITLES = {"throughput": "(a) Throughput (pps)", "pdr": "(b) PDR (%)", "delay_ms": "(c) Delay (ms)",
          "reliability": "(d) Reliability (%)", "lifetime": "(e) Lifetime (frames)",
          "overhead": "(f) Overhead (%)"}


def run_one(args):
    proto, cfgd, seed = args
    m = Sim(proto, Cfg(**cfgd), seed).run()
    m.update(proto=proto, seed=seed)
    return m


def sweep(name, xs, make_cfg, protos, seeds, jobs, base):
    tasks = []
    for x in xs:
        for p in protos:
            for s in range(seeds):
                tasks.append((p, asdict(make_cfg(base, x)), 100 + s))
    print(f"[{name}] {len(tasks)} runs ...", flush=True)
    if jobs > 1:
        with ProcessPoolExecutor(jobs) as ex:
            out = list(ex.map(run_one, tasks))
    else:
        out = [run_one(t) for t in tasks]
    rows, i = [], 0
    for x in xs:
        for p in protos:
            for s in range(seeds):
                r = out[i]; i += 1
                r["x"] = x
                rows.append(r)
    return rows


def aggregate(rows, xs, protos):
    agg = {p: {m: ([], []) for m in METRICS} for p in protos}
    for p in protos:
        for x in xs:
            sel = [r for r in rows if r["proto"] == p and r["x"] == x]
            for m in METRICS:
                v = np.array([r[m] for r in sel])
                agg[p][m][0].append(v.mean()); agg[p][m][1].append(v.std())
    return agg


def report(agg, xs, xlabel, protos):
    print(f"\n{'':14s}" + "".join(f"{m:>13s}" for m in METRICS))
    for p in protos:
        print(f"{LABELS[p]:14s}" + "".join(f"{np.mean(agg[p][m][0]):13.2f}" for m in METRICS))
    if "qai" in protos and "dcd" in protos:
        q, d = agg["qai"], agg["dcd"]
        imp = {
            "throughput": 100 * (np.array(q["throughput"][0]) / np.array(d["throughput"][0]) - 1),
            "delay_ms": 100 * (1 - np.array(q["delay_ms"][0]) / np.array(d["delay_ms"][0])),
            "lifetime": 100 * (np.array(q["lifetime"][0]) / np.array(d["lifetime"][0]) - 1),
            "overhead": 100 * (1 - np.array(q["overhead"][0]) / np.array(d["overhead"][0])),
        }
        print(f"\nQAI-DCDMAC vs DCD-MAC (mean over {xlabel}):")
        for k, v in imp.items():
            word = "reduction" if k in ("delay_ms", "overhead") else "improvement"
            print(f"  {k:12s} {word}: {v.mean():6.1f} %   (range {v.min():.1f} .. {v.max():.1f})")


def save(rows, agg, xs, xlabel, protos, tag, outdir):
    os.makedirs(outdir, exist_ok=True)
    with open(os.path.join(outdir, f"results_{tag}.csv"), "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=["x", "proto", "seed"] + METRICS + ["energy_J"])
        w.writeheader()
        for r in rows:
            w.writerow({k: r[k] for k in w.fieldnames})
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except ImportError:
        print("matplotlib not installed - skipping plots"); return
    fig, axes = plt.subplots(2, 3, figsize=(15, 8))
    styles = {"smac": ("s-", "k"), "dcd": ("o-", "r"), "rlmac": ("^-", "b"),
              "qai": ("v-", "g"), "dqn": ("d--", "m")}
    for ax, m in zip(axes.ravel(), METRICS):
        for p in protos:
            mk, col = styles[p]
            mu, sd = np.array(agg[p][m][0]), np.array(agg[p][m][1])
            ax.plot(xs, mu, mk, color=col, label=LABELS[p])
            ax.fill_between(xs, mu - sd, mu + sd, color=col, alpha=0.12)
        ax.set_title(TITLES[m]); ax.set_xlabel(xlabel); ax.grid(alpha=0.3)
    axes[0, 0].legend()
    fig.tight_layout()
    path = os.path.join(outdir, f"fig_{tag}.png")
    fig.savefig(path, dpi=150)
    print("saved", path)


def main():
    ap = argparse.ArgumentParser(description="QAI-DCDMAC simulator")
    ap.add_argument("mode", choices=["demo", "density", "load", "all"])
    ap.add_argument("--seeds", type=int, default=3)
    ap.add_argument("--jobs", type=int, default=max(1, (os.cpu_count() or 2) - 1))
    ap.add_argument("--quick", action="store_true", help="fewer frames / points (sanity run)")
    ap.add_argument("--ablation", action="store_true", help="also run DQN without quantum features")
    ap.add_argument("--out", default="qai_results")
    a = ap.parse_args()

    base = Cfg()
    protos = list(PROTOCOLS if a.ablation else ("smac", "dcd", "rlmac", "qai"))
    if a.quick:
        base.frames, base.train_frames = 300, 150
        a.seeds = min(a.seeds, 1)

    if a.mode == "demo":
        for p in protos:
            m = Sim(p, base, 100).run()
            print(f"{LABELS[p]:22s}" + "  ".join(f"{k}={m[k]:.2f}" for k in METRICS))
        return

    if a.mode in ("density", "all"):
        xs = [50, 100, 150] if a.quick else [50, 70, 90, 110, 130, 150]
        mk = lambda b, x: Cfg(**{**asdict(b), "n_nodes": x, "load_pps": 0.8 * x})   # 0.8 pps / node
        rows = sweep("density", xs, mk, protos, a.seeds, a.jobs, base)
        agg = aggregate(rows, xs, protos)
        report(agg, xs, "node density", protos)
        save(rows, agg, xs, "Number of nodes", protos, "density", a.out)

    if a.mode in ("load", "all"):
        xs = [20, 100, 200] if a.quick else [20, 50, 80, 110, 140, 170, 200]
        mk = lambda b, x: Cfg(**{**asdict(b), "n_nodes": 100, "load_pps": float(x)})
        rows = sweep("load", xs, mk, protos, a.seeds, a.jobs, base)
        agg = aggregate(rows, xs, protos)
        report(agg, xs, "traffic load", protos)
        save(rows, agg, xs, "Offered load (pps)", protos, "load", a.out)


if __name__ == "__main__":
    main()
